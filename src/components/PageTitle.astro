---
import Default from '@astrojs/starlight/components/PageTitle.astro';
const rb = Astro.locals.starlightRoute.entry.data.runbook;
---
<Default />
{rb && (
  <div class="rb-facts not-content">
    <dl aria-label="Runbook facts">
      <dt>Track</dt><dd>{rb.track}</dd>
      <dt>Level</dt><dd>{rb.level}</dd>
      <dt>Time</dt><dd>{rb.time}</dd>
      <dt>Cost</dt><dd>{rb.cost}</dd>
      <dt>Last verified</dt><dd>{rb.verified}</dd>
    </dl>
    {rb.prerequisites.length > 0 && (
      <div class="rb-prereq">
        <p>Before you start</p>
        <ul>{rb.prerequisites.map((p) => <li>{p}</li>)}</ul>
      </div>
    )}
  </div>
)}
